# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Configuration (Resend)
RESEND_API_KEY=re_your_api_key_here
ANALYST_EMAIL_RECIPIENT=your-email@example.com
ADMIN_EMAIL_RECIPIENT=admin@example.com

# Cron Job Security (Optional)
# Protects cron endpoints from unauthorized access
CRON_SECRET=your-secret-key-here

# Deployment Configuration (Optional)
# Used for generating absolute URLs in emails
RENDER_EXTERNAL_URL=https://your-domain.com

# Python Scanner (Optional)
# Set to 1 to disable Python scanner and use fallback data
# DISABLE_PYTHON_SCANNER=1
